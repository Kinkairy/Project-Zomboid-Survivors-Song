    {
      "key": "Sandbox_SurvivorsSong_SkillXP_tooltip",
      "en": "Controls recording and recovery of skill XP only. Recipes, skill books and training media have independent switches. Recording requires headphones and a microphone; recovery requires headphones.",
      "cn": "仅控制技能经验的录入和恢复。配方、技能书和培训媒体分别有独立开关。录入需要耳机和麦克风，恢复需要耳机。",
      "ch": "僅控制技能經驗的錄入和恢復。配方、技能書和培訓媒體分別有獨立開關。錄入需要耳機和麥克風，恢復需要耳機。",
      "reviewed": true,
      "runtime_group": "workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"
    },
    {
      "key": "Sandbox_SurvivorsSong_RecordTimeMultiplier",
      "en": "Knowledge recording time multiplier",
      "cn": "知识录入时间倍率",
      "ch": "知識錄入時間倍率",
      "reviewed": true,
