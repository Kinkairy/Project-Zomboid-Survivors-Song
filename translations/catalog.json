{"schema":1,"languages":["EN","CN","CH"],"alignment_rule":"same key, same player-visible meaning","entries":[{"key":"ContextMenu_SurvivorsSong_EraseCD","en":"Erase CD","cn":"擦除 CD","ch":"擦除 CD","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"ContextMenu_SurvivorsSong_ErasingCD","en":"Erasing CD","cn":"正在擦除 CD","ch":"正在擦除 CD","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"ContextMenu_SurvivorsSong_RecordingCD","en":"Recording skills to CD","cn":"正在将技能录入 CD","ch":"正在將技能錄入 CD","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"ContextMenu_SurvivorsSong_RestoringCD","en":"Restoring skills from CD","cn":"正在从 CD 恢复技能","ch":"正在從 CD 恢復技能","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"ContextMenu_SurvivorsSong_NeedPower","en":"The CD player needs power.","cn":"CD 机需要电力。","ch":"CD 機需要電力。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"ContextMenu_SurvivorsSong_DeviceBusy","en":"Stop the current CD action first.","cn":"请先停止当前 CD 操作。","ch":"請先停止目前的 CD 操作。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/ContextMenu.json"},{"key":"IGUI_SurvivorsSong_SongName","en":"%1's Song","cn":"%1的歌","ch":"%1的歌","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/IG_UI.json"},{"key":"Sandbox_SurvivorsSong","en":"Survivor's Song","cn":"幸存者之歌","ch":"倖存者之歌","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration","en":"CD playback length","cn":"CD 播放时长","ch":"CD 播放時長","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration_tooltip","en":"Maximum normal-CD playback time measured in game minutes. If the native CD program ends early, it repeats until this limit. Manual Stop always ends playback immediately.","cn":"普通 CD 的最长播放时间，按游戏内分钟计算。原版 CD 内容提前播完时会从头继续，直到达到该时长；手动停止会立即结束。","ch":"普通 CD 的最長播放時間，按遊戲內分鐘計算。原版 CD 內容提前播完時會從頭繼續，直到達到該時長；手動停止會立即結束。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration_Values_option1","en":"Vanilla","cn":"原版","ch":"原版","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration_Values_option2","en":"30 game minutes","cn":"30 游戏分钟","ch":"30 遊戲分鐘","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration_Values_option3","en":"60 game minutes","cn":"60 游戏分钟","ch":"60 遊戲分鐘","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_PlaybackDuration_Values_option4","en":"120 game minutes","cn":"120 游戏分钟","ch":"120 遊戲分鐘","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceBoredom","en":"Reduce boredom","cn":"降低无聊","ch":"降低無聊","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceBoredom_tooltip","en":"Allows the additional normal-CD listening effect to reduce Boredom. Enabled by default.","cn":"允许普通 CD 的额外收听效果降低无聊。默认开启。","ch":"允許普通 CD 的額外收聽效果降低無聊。預設開啟。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceUnhappiness","en":"Reduce unhappiness","cn":"降低不开心","ch":"降低不開心","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceUnhappiness_tooltip","en":"Allows the additional normal-CD listening effect to reduce Unhappiness. Enabled by default.","cn":"允许普通 CD 的额外收听效果降低不开心。默认开启。","ch":"允許普通 CD 的額外收聽效果降低不開心。預設開啟。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceStress","en":"Reduce stress","cn":"降低压力","ch":"降低壓力","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceStress_tooltip","en":"Allows the additional normal-CD listening effect to reduce Stress. Enabled by default.","cn":"允许普通 CD 的额外收听效果降低压力。默认开启。","ch":"允許普通 CD 的額外收聽效果降低壓力。預設開啟。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReducePanic","en":"Reduce panic","cn":"降低恐慌","ch":"降低恐慌","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReducePanic_tooltip","en":"Allows the additional normal-CD listening effect to reduce Panic. Disabled by default.","cn":"允许普通 CD 的额外收听效果降低恐慌。默认关闭。","ch":"允許普通 CD 的額外收聽效果降低恐慌。預設關閉。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceAnger","en":"Reduce anger","cn":"降低愤怒","ch":"降低憤怒","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_ReduceAnger_tooltip","en":"Allows the additional normal-CD listening effect to reduce Anger. Disabled by default.","cn":"允许普通 CD 的额外收听效果降低愤怒。默认关闭。","ch":"允許普通 CD 的額外收聽效果降低憤怒。預設關閉。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_SkillXP","en":"Record and restore skill XP","cn":"记录和恢复技能经验","ch":"記錄和恢復技能經驗","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_SkillXP_tooltip","en":"Controls the erased-CD skill system. Recording requires a blank CD in the player, installed headphones, and a carried microphone. A recorded song restores through Play with installed headphones.","cn":"控制擦除 CD 后的技能系统。录入需要 CD 机内有空白 CD、已安装耳机且角色携带麦克风；已录制的歌在安装耳机后通过“播放”恢复技能。","ch":"控制擦除 CD 後的技能系統。錄入需要 CD 機內有空白 CD、已安裝耳機且角色攜帶麥克風；已錄製的歌在安裝耳機後透過「播放」恢復技能。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RecordTimeMultiplier","en":"Skill recording time multiplier","cn":"技能录入时间倍率","ch":"技能錄入時間倍率","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RecordTimeMultiplier_tooltip","en":"Scales recording time. At 1.0, the skill-only workload and vanilla time scaling match Personal Journal writing.","cn":"调整技能录入时间。1.0 时，技能工作量和原版时间换算与个人日志的书写时间一致。","ch":"調整技能錄入時間。1.0 時，技能工作量和原版時間換算與個人日誌的書寫時間一致。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RestoreTimeMultiplier","en":"Skill recovery time multiplier","cn":"技能恢复时间倍率","ch":"技能恢復時間倍率","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RestoreTimeMultiplier_tooltip","en":"Scales recovery time. At 1.0, the skill-only workload uses the same vanilla reading-duration path as Personal Journal recovery.","cn":"调整技能恢复时间。1.0 时，技能工作量使用与个人日志恢复相同的原版阅读时长路径。","ch":"調整技能恢復時間。1.0 時，技能工作量使用與個人日誌恢復相同的原版閱讀時長路徑。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RecoveryPercent","en":"Skill recovery percentage","cn":"技能恢复比例","ch":"技能恢復比例","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"Sandbox_SurvivorsSong_RecoveryPercent_tooltip","en":"Percentage of the XP stored in a recorded song that can be restored. Recovery only fills missing XP and never lowers current skills.","cn":"设置录制歌曲中已记录经验可恢复的比例。恢复只补足缺少的经验，不会降低当前技能。","ch":"設定錄製歌曲中已記錄經驗可恢復的比例。恢復只補足缺少的經驗，不會降低目前技能。","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"},{"key":"IGUI_SurvivorsSong_WaitServer","en":"%1 - waiting for server progress","cn":"%1 — 等待服务器进度","ch":"%1 — 等待伺服器進度","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/IG_UI.json"},{"key":"IGUI_SurvivorsSong_Applying","en":"%1 - applying results","cn":"%1 — 正在处理结果","ch":"%1 — 正在處理結果","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/IG_UI.json"},{"key":"IGUI_SurvivorsSong_WaitActionDone","en":"%1 - waiting for action completion confirmation","cn":"%1 — 等待动作完成确认","ch":"%1 — 等待動作完成確認","reviewed":true,"runtime_group":"workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/IG_UI.json"}]}
