    },
    {
      "key": "Sandbox_SurvivorsSong_RecordTimeMultiplier_tooltip",
      "en": "Scales recording time. At 1.0, XP, recipes, skill-book state and training-media workload use the same page weights and time scaling as Personal Journal writing.",
      "cn": "调整知识录入时间。1.0 时，经验、配方、技能书状态和培训媒体采用与个人日志书写相同的页数权重和时间换算。",
      "ch": "調整知識錄入時間。1.0 時，經驗、配方、技能書狀態和培訓媒體採用與個人日誌書寫相同的頁數權重和時間換算。",
      "reviewed": true,
      "runtime_group": "workshop/Contents/mods/SurvivorsSong/42.20/media/lua/shared/Translate/{LOCALE}/Sandbox.json"
    },
    {
      "key": "Sandbox_SurvivorsSong_RestoreTimeMultiplier",
      "en": "Knowledge recovery time multiplier",
      "cn": "知识恢复时间倍率",
